// Usage: node scripts/benchmark-smart-mode.mjs OUTPUT_DIRECTORY AUDIO [AUDIO ...]
// Runs real models locally. Calibration is explicit and its time is reported separately.
import { mkdir, writeFile, readFile } from 'node:fs/promises';
import { resolve, join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { cpus, totalmem, freemem } from 'node:os';
import { createQueueTranscriber, createWorker } from '../src/queue-transcriber.js';
import { cpuThreads, SMART_VERSION } from '../src/smart-scheduler.js';
import { generateCaptionBatchJob } from '../src/application/generate-caption-batch-job.js';
import { resolveModelSelection } from '../src/whisperx-runner.js';
import { extractAlignedTimeline } from '../src/pipeline.js';

const reuse = process.argv.includes('--reuse-calibration');
const [output, ...files] = process.argv.slice(2).filter(arg => arg !== '--reuse-calibration');
if (!output || files.length < (reuse ? 1 : 3)) throw new Error('Supply an output directory and at least three audio files for calibration.');
const root = process.env.PORTABLE_EXECUTABLE_DIR ?? resolve(dirname(fileURLToPath(import.meta.url)), '..');
const out = resolve(output);
await mkdir(out, { recursive: true });
const model = resolveModelSelection('large-v3-turbo');
const measurements = [], decisions = [];
let minimumFree = freemem();
const sample = setInterval(() => { minimumFree = Math.min(minimumFree, freemem()); }, 250);
const initialFree = freemem();
const onMeasurement = value => measurements.push(value);
let worker;
let report;
try {
  const run = async (smartMode, profile) => {
    const name = smartMode ? 'smart' : 'normal';
    const requests = files.map((path, i) => ({ inputPath: resolve(path), outputPath: join(out, `${name}-${i}.srt`),
      model, device: 'cuda', smartMode, overwrite: true }));
    const start = performance.now();
    await generateCaptionBatchJob({ requests, onProgress: e => { if (e.smart) { decisions.push(e.smart); console.log(e.smart.reason); } } }, {
      createQueueTranscriber: opts => createQueueTranscriber({ ...opts, smartProfile: profile, calibrate: true, onMeasurement })
    });
    return (performance.now() - start) / 1000;
  };
  const normalSeconds = await run(false);
  let profile, calibrationSeconds = 0, consistency = [];
  if (reuse) { profile = JSON.parse(await readFile(join(root, 'data', 'smart-profile.json'), 'utf8')); } else {
  const recognition = measurements.filter(e => e.type === 'transcribe');
  const normalAlignment = measurements.find(e => e.type === 'gpu-align').aligned;
  if (recognition.some(e => !e.cuda || e.transcript.segments.some(s => s.recovery))) throw new Error('Calibration requires GPU recognition without recovery.');
  const start = performance.now();
  worker = await createWorker({ device: 'cpu', cpuThreads: cpuThreads() });
  const cpu = [];

  for (const item of recognition) {
    const result = await worker.alignOne(item.transcript);
    cpu.push(result);
    const a = extractAlignedTimeline(normalAlignment.find(e => e.fileIndex === item.fileIndex).srt).words;
    const b = extractAlignedTimeline(result.aligned.srt).words;
    consistency.push(a.length === b.length && a.every((word, i) => word.text === b[i].text
      && Math.abs(word.start - b[i].start) <= 20 && Math.abs(word.end - b[i].end) <= 20));
  }
  await worker.close(); worker = undefined;
  calibrationSeconds = (performance.now() - start) / 1000;
  const audioSeconds = recognition.reduce((sum, e) => sum + e.duration, 0);
  const steady = recognition.slice(1);
  profile = { version: SMART_VERSION, created: Date.now(), model, hardware: recognition[0].hardware,
    threads: cpuThreads(), cpuModel: cpus()[0].model, logicalThreads: cpus().length, samples: cpu.length,
    validated: consistency.every(Boolean), minDuration: Math.min(...recognition.map(e => e.duration)),
    maxDuration: Math.max(...recognition.map(e => e.duration)),
    transcriptionRtf: steady.reduce((sum, e) => sum + e.seconds, 0) / steady.reduce((sum, e) => sum + e.duration, 0),
    gpuRtf: normalAlignment.reduce((sum, e) => sum + e.seconds, 0) / audioSeconds,
    cpuRtf: cpu.reduce((sum, e) => sum + e.seconds - e.initSeconds, 0) / audioSeconds,
    startupSeconds: calibrationSeconds - cpu.reduce((sum, e) => sum + e.seconds - e.initSeconds, 0),
    ramBytes: Math.max(1024 ** 3, initialFree - minimumFree) };
  console.log('Calibration', JSON.stringify(profile));
  if (!profile.validated) throw new Error('CPU/GPU alignment differed beyond the 20 ms tolerance; no profile installed.');
  }
  const smartSeconds = await run(true, profile);
  const exportsEqual = [];
  for (let i = 0; i < files.length; i++) exportsEqual.push((await readFile(join(out, `normal-${i}.srt`), 'utf8')) === (await readFile(join(out, `smart-${i}.srt`), 'utf8')));
  // Never install a profile from a measured regression or changed exports.
  profile.validated &&= smartSeconds <= normalSeconds && exportsEqual.every(Boolean);
  report = { normalSeconds, smartSeconds, calibrationSeconds, exportsEqual, alignmentWithin20ms: consistency,
    profile, decisions, resourceSample: { totalRam: totalmem(), initialFree, minimumFree },
    measurements: measurements.map(({ transcript, aligned, ...value }) => ({ ...value,
      aligned: Array.isArray(aligned) ? aligned.map(({ srt, ...entry }) => entry) : undefined })) };
  await mkdir(join(root, 'data'), { recursive: true });
  // Keep calibration local to this installation, disabled after any measured regression.
  await writeFile(join(root, 'data', 'smart-profile.json'), JSON.stringify(profile, null, 2));
  await writeFile(join(out, 'benchmark.json'), JSON.stringify(report, null, 2));
  console.log(JSON.stringify({ normalSeconds, smartSeconds, calibrationSeconds, profileEnabled: profile.validated, exportsEqual }));
} finally {
  clearInterval(sample);
  await worker?.close();
}

